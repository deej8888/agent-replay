AGENTREPLAY_DATABASE_URL=sqlite:///./agentreplay.db
# Optional shared key. Set the same value in the SDK and Next.js server.
AGENTREPLAY_API_KEY=
AGENTREPLAY_API_URL=http://127.0.0.1:8000
# Server-side only: the browser uses the Next.js /api proxy.
AGENTREPLAY_BACKEND_URL=http://127.0.0.1:8000
AGENTREPLAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
